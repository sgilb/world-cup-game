# Admin password (required to access /admin). Change this!
ADMIN_PASSWORD=changeme

# Session secret for the signed admin cookie
SESSION_SECRET=please-change-this-to-a-long-random-string

# Port
PORT=3000

# ---------------------------------------------------------------------------
# Live results
# The app works fully via manual score entry with NO key. To auto-fetch:
#   1. set POLL_ENABLED=true
#   2. configure ONE provider below (RESULTS_PROVIDER)
# ---------------------------------------------------------------------------
POLL_ENABLED=false
# Score-poll cadence (minutes) while inside a live window.
POLL_INTERVAL_MIN=5
# How often (hours) to sync the real fixture schedule / auto-populate the
# knockout bracket. Runs regardless of live windows.
SCHEDULE_SYNC_HOURS=6

# Which provider: 'football-data' (default, best for free final-results) or 'api-football'.
RESULTS_PROVIDER=football-data

# --- football-data.org (default) — 10 req/min, no daily cap, WC on free ---
# Get a free key at https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=
FOOTBALL_DATA_COMPETITION=WC

# --- api-football (api-sports.io) — only if you need live in-play scores ---
# 100 req/day; verify WC 2026 season is on your plan. https://www.api-football.com/
API_FOOTBALL_KEY=
WC_LEAGUE_ID=1
WC_SEASON=2026
