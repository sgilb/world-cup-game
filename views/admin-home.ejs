<%- include('partials/head', { title: 'Admin', showLogout: true }) %>
<h1>Your sweepstakes games</h1>
<% if (typeof flash !== 'undefined' && flash) { %><div class="flash"><%= flash %></div><% } %>

<div class="card">
  <h2>Create a new game</h2>
  <form method="post" action="/admin/games" class="row">
    <input type="text" name="name" placeholder="e.g. Office World Cup 2026" required>
    <button type="submit" class="primary">Create</button>
  </form>
</div>

<div class="card">
  <h2>Existing games</h2>
  <% if (games.length === 0) { %>
    <p class="muted">No games yet — create one above.</p>
  <% } else { %>
    <ul class="game-list">
      <% games.forEach(function(g) { %>
        <li>
          <a href="/admin/games/<%= g.id %>"><%= g.name %></a>
          <span class="pill pill-<%= g.status %>"><%= g.status %></span>
          <form method="post" action="/admin/games/<%= g.id %>/delete" class="inline"
                onsubmit="return confirm('Delete \'<%= g.name.replace(/'/g, "\\'") %>\'? This permanently removes its participants, their links, team assignments and all results. This cannot be undone.');">
            <button class="link-btn danger" title="Delete game">Delete</button>
          </form>
        </li>
      <% }); %>
    </ul>
  <% } %>
</div>
<%- include('partials/foot') %>
